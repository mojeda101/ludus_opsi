# {{ ansible_managed }}
# OPSI server stack - generated by the Ansible role ludus_opsi
# Role: {{ ludus_opsi_host_role }}

x-restart-policy: &restart-policy
  restart: unless-stopped

x-common-variables: &common-variables
  TZ: "{{ ludus_opsi_timezone }}"

x-common-mysql-variables: &common-mysql-variables
  MYSQL_DATABASE: opsi
  MYSQL_USER: opsi
  MYSQL_PASSWORD: "{{ ludus_opsi_mysql_password }}"

x-common-redis-variables: &common-redis-variables
  REDIS_PASSWORD: "{{ ludus_opsi_redis_password }}"

x-common-grafana-variables: &common-grafana-variables
  GF_SECURITY_ADMIN_USER: admin
  GF_SECURITY_ADMIN_PASSWORD: "{{ ludus_opsi_grafana_admin_password }}"

volumes:
{% if ludus_opsi_deploy_mysql | bool %}
  mysql_data:
    driver: local
{% endif %}
  redis_data:
    driver: local
  opsi_data:
    driver: local
{% if ludus_opsi_deploy_grafana | bool %}
  grafana_data:
    driver: local
{% endif %}

services:
{% if ludus_opsi_deploy_mysql | bool %}
  mysql:
    image: mariadb:10.7
    <<: *restart-policy
    command: --max_connections=1000 --max_allowed_packet=256M --sort_buffer_size=4M
    environment:
      <<: [*common-variables, *common-mysql-variables]
      MYSQL_ROOT_PASSWORD: "{{ ludus_opsi_mysql_root_password }}"
      MYSQL_INITDB_SKIP_TZINFO: 1
    volumes:
      - mysql_data:/var/lib/mysql

{% endif %}
  redis:
    image: redis/redis-stack-server:latest
    <<: *restart-policy
    command: sh -c "redis-server --requirepass $$REDIS_PASSWORD --loadmodule /opt/redis-stack/lib/redistimeseries.so --dir /data"
    environment:
      <<: [*common-variables, *common-redis-variables]
    volumes:
      - redis_data:/data

{% if ludus_opsi_deploy_grafana | bool %}
  grafana:
    image: grafana/grafana:latest
    <<: *restart-policy
    environment:
      <<: [*common-variables, *common-grafana-variables]
      GF_INSTALL_PLUGINS: simpod-json-datasource
      GF_SERVER_ROOT_URL: "%(protocol)s://%(domain)s:%(http_port)s/grafana"
    volumes:
      - grafana_data:/var/lib/grafana

{% endif %}
  opsi-server:
{% if ludus_opsi_ad_login_enabled | bool %}
    build:
      context: ./opsi-sssd
      dockerfile: Dockerfile
    image: ludus-opsi-server-sssd:{{ ludus_opsi_image_tag }}
{% else %}
    image: uibmz/opsi-server:{{ ludus_opsi_image_tag }}
{% endif %}
    <<: *restart-policy
    depends_on:
{% if ludus_opsi_deploy_mysql | bool %}
      - mysql
{% endif %}
      - redis
    ports:
      - "{{ ludus_opsi_https_port }}:4447"
{% if ludus_opsi_tftpboot | string | lower == 'true' %}
      - "{{ ludus_opsi_tftp_port }}:69/udp"
{% endif %}
    hostname: "{{ ludus_opsi_hostname }}"
    domainname: "{{ ludus_opsi_domainname }}"
    environment:
      <<: [*common-variables, *common-redis-variables{% if ludus_opsi_deploy_mysql | bool %}, *common-mysql-variables{% endif %}{% if ludus_opsi_deploy_grafana | bool %}, *common-grafana-variables{% endif %}]
{% if ludus_opsi_deploy_mysql | bool %}
      MYSQL_HOST: mysql
      MYSQL_PORT: 3306
{% endif %}
      REDIS_HOST: redis
{% if ludus_opsi_deploy_grafana | bool %}
      GRAFANA_HOST: grafana
{% endif %}
      OPSI_ADMIN_PASSWORD: "{{ ludus_opsi_admin_password }}"
      OPSI_ROOT_PASSWORD: "{{ ludus_opsi_root_password }}"
      OPSI_HOST_ROLE: "{{ ludus_opsi_host_role }}"
      OPSI_TFTPBOOT: "{{ ludus_opsi_tftpboot }}"
{% if ludus_opsi_host_role == 'depotserver' %}
      OPSI_SERVICE_ADDRESS: "{{ ludus_opsi_service_address }}"
      OPSI_HOST_KEY: "{{ ludus_opsi_host_key }}"
{% endif %}
{% if ludus_opsi_deploy_grafana | bool %}
      OPSICONFD_GRAFANA_EXTERNAL_URL: /grafana
{% endif %}
      OPSICONFD_LOG_LEVEL: 6
      OPSICONFD_LOG_LEVEL_FILE: 4
    volumes:
      - opsi_data:/data
{% if ludus_opsi_ad_login_enabled | bool %}
      # host SSSD sockets -> container uses the host's SSSD daemon for NSS/PAM
      - /var/lib/sss/pipes:/var/lib/sss/pipes
{% endif %}
